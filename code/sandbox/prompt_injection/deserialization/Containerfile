FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN useradd -m -u 1000 appuser
WORKDIR /home/appuser/app

COPY packages.txt .
RUN if [ -s packages.txt ]; then apt-get update && xargs -a packages.txt apt-get install -y --no-install-recommends && rm -rf /var/lib/apt/lists/*; fi

COPY pyproject.toml uv.lock ./
ENV UV_PROJECT_ENVIRONMENT="/opt/venv"
RUN uv sync --frozen --no-dev

COPY . .
RUN chmod +x entrypoint.sh && chown -R appuser:appuser /home/appuser/app /opt/venv

USER appuser
EXPOSE 8000 7860
ENTRYPOINT ["./entrypoint.sh"]
